---
/**
 * One hero, four looks — kills the "every subpage hero is identical" problem.
 *  - editorial : type-led, brass datum rule, no photo (asset-light)
 *  - figure    : editorial + a lead stat on the right
 *  - photo     : parallax photo + scrims (the original treatment)
 *  - compact   : short utility band (optional faint photo)
 */
interface Crumb { label: string; href?: string }
interface Stat { value: string; label: string }
interface Props {
  variant?: 'editorial' | 'figure' | 'photo' | 'compact';
  breadcrumb?: Crumb[];
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: string;
  stat?: Stat;
}
const { variant = 'editorial', breadcrumb = [], eyebrow, title, lead, image, stat } = Astro.props;
const usesPhoto = variant === 'photo' || variant === 'compact';
const titleSize = variant === 'compact' ? 'clamp(1.7rem,3.6vw,2.6rem)' : 'clamp(2rem,4.8vw,3.4rem)';
---
{usesPhoto ? (
  <section class="relative overflow-hidden border-b" style="border-color:var(--border);">
    {image && <img src={image} alt="" aria-hidden="true" width="1600" height="320" class:list={['img-grade parallax-img absolute inset-0 w-full h-full object-cover', variant === 'compact' ? 'opacity-25' : 'opacity-45']} />}
    {variant === 'photo' && <div class="scrim-left"></div>}
    <div class="scrim-bottom"></div>
    <div class:list={['container-x relative', variant === 'compact' ? 'py-10 md:py-14' : 'py-16 md:py-20']}>
      {breadcrumb.length > 0 && (
        <nav class="t-caption flex flex-wrap items-center gap-2 mb-5" aria-label="Breadcrumb">
          {breadcrumb.map((c, i) => (
            <span class="flex items-center gap-2">
              {c.href ? <a href={c.href} class="hover:text-[var(--text)] transition">{c.label}</a> : <span style="color:var(--accent-soft)">{c.label}</span>}
              {i < breadcrumb.length - 1 && <span style="color:var(--text-faint)">/</span>}
            </span>
          ))}
        </nav>
      )}
      {eyebrow && <p class="t-eyebrow" data-reveal>{eyebrow}</p>}
      <h1 class="t-display mt-3" style={`font-size:${titleSize};`} data-reveal data-delay="1">{title}</h1>
      {lead && <p class="t-lead mt-4 max-w-2xl" data-reveal data-delay="2">{lead}</p>}
      {Astro.slots.has('default') && <div class="mt-5" data-reveal data-delay="3"><slot /></div>}
    </div>
  </section>
) : (
  <section class="section section--anchor relative overflow-hidden">
    <div class="container-x">
      {breadcrumb.length > 0 && (
        <nav class="t-caption flex flex-wrap items-center gap-2 mb-6" aria-label="Breadcrumb">
          {breadcrumb.map((c, i) => (
            <span class="flex items-center gap-2">
              {c.href ? <a href={c.href} class="hover:text-[var(--text)] transition">{c.label}</a> : <span style="color:var(--accent-soft)">{c.label}</span>}
              {i < breadcrumb.length - 1 && <span style="color:var(--text-faint)">/</span>}
            </span>
          ))}
        </nav>
      )}
      <div class:list={[variant === 'figure' && 'grid lg:grid-cols-[1fr_auto] gap-x-12 gap-y-8 items-end']}>
        <div class="relative pl-5 md:pl-7 max-w-3xl">
          <span class="datum-rule" aria-hidden="true"></span>
          {eyebrow && <p class="t-eyebrow" data-reveal>{eyebrow}</p>}
          <h1 class="t-display mt-3" style={`font-size:${titleSize};`} data-reveal data-delay="1">{title}</h1>
          {lead && <p class="t-lead mt-4" data-reveal data-delay="2">{lead}</p>}
          {Astro.slots.has('default') && <div class="mt-5" data-reveal data-delay="3"><slot /></div>}
        </div>
        {variant === 'figure' && stat && (
          <div class="hidden lg:block text-right shrink-0" data-reveal data-delay="2">
            <div class="stat-num" style="font-size:clamp(3rem,6vw,5rem);line-height:1;">{stat.value}</div>
            <div class="t-caption uppercase tracking-widest mt-2">{stat.label}</div>
          </div>
        )}
      </div>
    </div>
  </section>
)}

---
import { SERVICES, serviceHref } from '@/data/services';
import { ROUTES, type Locale } from '@/i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;

const copy = {
  fr: {
    home: 'Accueil', services: 'Services',
    eyebrow: 'Trois domaines, un partenaire',
    title: 'Ce que nous faisons',
    lead: "MINEFECT accompagne les mines africaines sur trois fronts complémentaires : la formation de vos équipes, la fourniture des équipements et consommables, et l'ingénierie pour optimiser vos procédés. Trois métiers, un seul interlocuteur.",
    explore: 'En savoir plus',
  },
  en: {
    home: 'Home', services: 'Services',
    eyebrow: 'Three domains, one partner',
    title: 'What we do',
    lead: 'MINEFECT supports African mines on three complementary fronts: training your teams, supplying equipment and consumables, and engineering to optimise your processes. Three disciplines, one point of contact.',
    explore: 'Learn more',
  },
}[lang];
const arrow = 'M5 12h14M12 5l7 7-7 7';
---
<section class="section section--anchor">
  <div class="container-x">
    <nav class="t-caption flex items-center gap-2 mb-6" aria-label="Breadcrumb">
      <a href={ROUTES.home[lang]} class="hover:text-[var(--text)] transition">{copy.home}</a>
      <span style="color:var(--text-faint)">/</span>
      <span style="color:var(--text-muted)">{copy.services}</span>
    </nav>
    <div class="max-w-3xl mb-10">
      <p class="t-eyebrow" data-reveal>{copy.eyebrow}</p>
      <h1 class="t-display mt-3" style="font-size:clamp(2rem,4.5vw,3.25rem);" data-reveal data-delay="1">{copy.title}</h1>
      <p class="t-lead mt-4" data-reveal data-delay="2">{copy.lead}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {SERVICES.map((s, i) => (
        <a href={serviceHref(s, lang)} class="card card--media card--feature group flex flex-col" data-reveal data-delay={String((i % 3) + 1)}>
          <div class="relative overflow-hidden">
            <img src={s.image} alt={s.title[lang]} loading="lazy" width="420" height="220" class="img-grade w-full h-52 object-cover transition-transform duration-500 group-hover:scale-105" />
            <span class="ghost-num absolute bottom-1 right-3 text-5xl" style="color:var(--gold);text-shadow:0 2px 10px rgba(0,0,0,0.6);">{s.num}</span>
          </div>
          <div class="card-body flex flex-col grow">
            <h2 class="t-h3 mb-2">{s.title[lang]}</h2>
            <p class="t-body-sm grow">{s.teaser[lang]}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium" style="color:var(--accent-soft);">{copy.explore}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={arrow}/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

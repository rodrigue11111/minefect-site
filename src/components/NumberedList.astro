---
/** Canonical numbered block — one component replacing the duplicated ghost-num grids. */
interface Item { title: string; body: string }
interface Props { items: Item[]; cols?: string }
const { items, cols = 'sm:grid-cols-2 lg:grid-cols-3' } = Astro.props;
---
<div class={`grid ${cols} gap-5`} data-reveal>
  {items.map((it, i) => (
    <article class="card card-body relative overflow-hidden">
      <span class="ghost-num absolute top-3 right-4 text-5xl pointer-events-none">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="t-h3 text-base mb-2 pr-10">{it.title}</h3>
      <p class="t-body-sm">{it.body}</p>
    </article>
  ))}
</div>

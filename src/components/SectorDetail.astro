---
import type { Sector } from '@/data/sectors';
import { ROUTES, type Locale } from '@/i18n/utils';
import StatRow from '@/components/StatRow.astro';
import NumberedList from '@/components/NumberedList.astro';

interface Props { sector: Sector; lang: Locale }
const { sector, lang } = Astro.props;

const L = {
  fr: { home: 'Accueil', sectors: 'Secteurs', challenges: 'Enjeux clés', solutions: 'Nos solutions', context: 'Contexte', cta: 'Discuter de ce secteur', back: 'Tous les secteurs' },
  en: { home: 'Home', sectors: 'Sectors', challenges: 'Key challenges', solutions: 'Our solutions', context: 'Context', cta: 'Discuss this sector', back: 'All sectors' },
}[lang];
const check = 'M5 13l4 4L19 7';
---
<section class="relative overflow-hidden border-b" style="border-color:var(--border);">
  <img src={sector.image} alt="" aria-hidden="true" width="1600" height="320" class="img-grade parallax-img absolute inset-0 w-full h-full object-cover opacity-45" onerror="this.onerror=null;this.src='/assets/images/placeholders/sector.png'" />
  <div class="scrim-left"></div>
  <div class="scrim-bottom"></div>
  <div class="container-x relative py-16 md:py-20">
    <nav class="t-caption flex items-center gap-2 mb-5" aria-label="Breadcrumb">
      <a href={ROUTES.home[lang]} class="hover:text-[var(--text)] transition">{L.home}</a>
      <span style="color:var(--text-faint)">/</span>
      <a href={ROUTES.sectors[lang]} class="hover:text-[var(--text)] transition">{L.sectors}</a>
      <span style="color:var(--text-faint)">/</span>
      <span style="color:var(--accent-soft)">{sector.title[lang]}</span>
    </nav>
    <h1 class="t-display" style="font-size:clamp(2rem,4.5vw,3.25rem);" data-reveal>{sector.title[lang]}</h1>
    <p class="t-lead mt-4 max-w-2xl" data-reveal data-delay="1">{sector.lead[lang]}</p>
  </div>
</section>

<!-- Stats -->
<section class="section--tight section--surface border-b" style="border-color:var(--border);">
  <div class="container-x">
    <StatRow stats={sector.stats.map((s) => ({ value: typeof s.value === 'string' ? s.value : s.value[lang], label: s.label[lang] }))} />
  </div>
</section>

<!-- Context -->
<section class="section section--anchor">
  <div class="container-x max-w-3xl">
    <p class="t-eyebrow mb-3" data-reveal>{L.context}</p>
    <p class="t-lead" data-reveal data-delay="1">{sector.context[lang]}</p>
  </div>
</section>

<!-- Challenges -->
<section class="section--tight section--surface">
  <div class="container-x">
    <div class="section-head" data-reveal>
      <p class="t-eyebrow">{L.challenges}</p>
    </div>
    <NumberedList cols="md:grid-cols-3" items={sector.challenges.map((c) => ({ title: c.title[lang], body: c.body[lang] }))} />
  </div>
</section>

<!-- Solutions -->
<section class="section section--anchor">
  <div class="container-x max-w-4xl">
    <div class="section-head" data-reveal>
      <p class="t-eyebrow">{L.solutions}</p>
    </div>
    <ul class="grid sm:grid-cols-2 gap-4">
      {sector.solutions.map((s, i) => (
        <li class="card card-body flex gap-3" data-reveal data-delay={String((i % 4) + 1)}>
          <span class="icon-tile shrink-0" style="width:2.25rem;height:2.25rem;background:var(--gold-soft);border-color:rgba(230,181,103,.3);color:var(--gold);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={check}/></svg>
          </span>
          <div>
            <h3 class="t-h3 text-sm mb-1">{s.title[lang]}</h3>
            <p class="t-body-sm">{s.body[lang]}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- CTA -->
<section class="section--tight relative overflow-hidden" style="background:var(--grad-section);">
  <div class="container-x max-w-3xl text-center">
    <a href={`${ROUTES.contact[lang]}`} class="btn btn-primary" data-reveal>{L.cta}</a>
    <div class="mt-4"><a href={ROUTES.sectors[lang]} class="text-sm" style="color:var(--text-muted);">← {L.back}</a></div>
  </div>
</section>

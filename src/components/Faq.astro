---
/** Accordion FAQ — uses the existing .faq-item styles in global.css. */
interface QA { q: string; a: string }
interface Props { items: QA[] }
const { items } = Astro.props;
---
<div class="grid gap-3" data-faq data-reveal>
  {items.map((it) => (
    <div class="faq-item">
      <button class="faq-btn" type="button" aria-expanded="false">
        <span>{it.q}</span>
        <svg class="faq-icon shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <div class="faq-answer"><p class="t-body-sm px-6 pb-5" set:html={it.a}></p></div>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll('[data-faq] .faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      if (!item) return;
      const open = item.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>

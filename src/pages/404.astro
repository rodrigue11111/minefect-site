---
import '@/styles/global.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — MINEFECT</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="theme-color" content="#060B16" />
  </head>
  <body>
    <main class="section" style="min-height:80vh;display:flex;align-items:center;">
      <div class="container-x text-center" style="max-width:36rem;margin-inline:auto;">
        <p class="stat-num" style="font-size:clamp(4rem,12vw,8rem);">404</p>
        <h1 class="t-h2 mt-2 mb-4">Page introuvable</h1>
        <p class="t-body mb-1">La page que vous cherchez a peut-être déménagé.</p>
        <p class="t-body-sm mb-8" style="color:var(--text-subtle);">The page you’re looking for may have moved.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/" class="btn btn-primary">Accueil</a>
          <a href="/en/" class="btn btn-ghost">English home</a>
        </div>
      </div>
    </main>
  </body>
</html>
